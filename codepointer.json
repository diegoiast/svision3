{
    "activeExecutableName": "",
    "activeTaskName": "",
    "buildDir": "${source_directory}/build",
    "displayFilter": "",
    "executables": [
        {
            "executables": {
                "linux": "SVISION_PAINT=cairo SVISION_BACKEND=x11 build/Debug/demo",
                "windows": "build\\Debug\\demo.exe"
            },
            "name": "Demo (native)",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "SVISION_PAINT=opengl SVISION_BACKEND=x11 build/Debug/demo",
                "windows": "Debug\\demo.exe"
            },
            "name": "Demo (opengl)",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "build//Debug/sqlite_viewer",
                "windows": "build\\Debug\\sqlite_viewer.exe"
            },
            "name": "SQLite viewer",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "build\\Debug/tests",
                "windows": "build\\Debug\\tests.exe"
            },
            "name": "Unit tests",
            "runDirectory": "${source_directory}"
        }
    ],
    "hideFilter": ".git;.vscode;.vs;cbuild;dist;out;build",
    "tasks": [
        {
            "commands": "powershell -Command \"Remove-Item -Path build -Recurse -Force -ErrorAction SilentlyContinue\"",
            "name": "Clean build directory",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": {
                "linux": [
                    "conan install . --output-folder=. --build=missing -s build_type=Debug",
                    "cmake --preset conan-debug -G Ninja"
                ],
                "windows": [
                    "conan install . --output-folder=. --build=missing -pr:h conan-debug",
                    "cmake --preset conan-default"
                ]
            },
            "isBuild": true,
            "name": "CMake (configure/Debug)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": {
                "linux": [
                    "conan install . --output-folder=. --build=missing -s build_type=Release",
                    "cmake --preset conan-release -G Ninja"
                ],
                "windows": [
                    "conan install . --output-folder=. --build=missing -pr:h default",
                    "cmake --preset conan-default"
                ]
            },
            "isBuild": true,
            "name": "CMake (configure/Release)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build build --preset conan-debug",
            "isBuild": true,
            "name": "CMake Build Debug (parallel)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build build --preset conan-release",
            "isBuild": true,
            "name": "CMake Build Release (parallel)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build build --preset conan-debug --verbose -j 1",
            "isBuild": true,
            "name": "CMake Build Debug (single thread)",
            "runDirectory": "${source_directory}"
        }
    ]
}
