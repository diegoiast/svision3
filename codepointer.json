{
    "activeExecutableName": "",
    "activeTaskName": "",
    "build_directory": "${source_directory}/build",
    "displayFilter": "",
    "executables": [
        {
            "executables": {
                "linux": "SVISION_PAINT=cairo SVISION_BACKEND=x11 ${build_directory}/Debug/demo",
                "windows": "${build_directory}\\Debug\\demo.exe"
            },
            "name": "Demo",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "${build_directory}/Debug/tests",
                "windows": "${build_directory}\\Debug\\tests.exe"
            },
            "name": "Unit tests",
            "runDirectory": "${source_directory}"
        }
    ],
    "hideFilter": ".git;.vscode;.vs;cbuild;dist;out;build",
    "tasks": [
        {
            "commands": {
                "linux": [
                    "~/.local/bin/conan install . -s build_type=Debug --build=missing",
                    "mkdir -p ${build_directory}/Debug/.cmake/api/v1/query/",
                    "touch ${build_directory}/Debug/.cmake/api/v1/query/codemodel-v2",
                    "cmake --preset conan-debug -G Ninja"
                ],
                "windows": [
                    "conan install . -s build_type=Debug --build=missing",
                    "if not exist \"${build_directory}/.cmake/api/v1/query\" mkdir \"${build_directory}/.cmake/api/v1/query\"",
                    "type nul > \"${build_directory}/.cmake/api/v1/query/codemodel-v2\"",
                    "cmake --preset conan-default"
                ]
            },
            "isBuild": true,
            "name": "CMake (configure/Debug)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": {
                "linux": [
                    "~/.local/bin/conan install . -s build_type=Release --build=missing",
                    "mkdir -p ${build_directory}/Release/.cmake/api/v1/query/",
                    "touch ${build_directory}/Release/.cmake/api/v1/query/codemodel-v2",
                    "cmake --preset conan-release -G Ninja"
                ],
                "windows": [
                    "conan install . -s build_type=Release --build=missing",
                    "if not exist \"${build_directory}/.cmake/api/v1/query\" mkdir \"${build_directory}/.cmake/api/v1/query\"",
                    "type nul > \"${build_directory}/.cmake/api/v1/query/codemodel-v2\"",
                    "cmake --preset conan-default"
                ]
            },
            "isBuild": true,
            "name": "CMake (configure/Release)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-debug",
            "isBuild": true,
            "name": "CMake Build Debug (parallel)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-release",
            "isBuild": true,
            "name": "CMake Build Release (parallel)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-debug --verbose -j 1",
            "isBuild": true,
            "name": "CMake Build Debug (single thread)",
            "runDirectory": "${source_directory}"
        }
    ]
}
