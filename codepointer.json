{
    "activeExecutableName": "",
    "activeTaskName": "",
    "buildDir": "${source_directory}/build",
    "displayFilter": "",
    "executables": [
        {
            "executables": {
                "linux": "SVISION_PAINT=cairo SVISION_BACKEND=x11 build/Debug/demo",
                "windows": "${build_directory}\\Debug\\demo.exe"
            },
            "name": "Demo (native)",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "SVISION_PAINT=opengl SVISION_BACKEND=x11 build/Debug/demo",
                "windows": "${build_dir}\\Debug\\demo.exe"
            },
            "name": "Demo (opengl)",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "${build_directory}/Debug/tests",
                "windows": "${build_directory}\\Debug\\tests.exe"
            },
            "name": "Unit tests",
            "runDirectory": "${source_directory}"
        }
    ],
    "hideFilter": ".git;.vscode;.vs;cbuild;dist;out;build",
    "tasks": [
        {
            "commands": {
                "linux": [
                    "~/.local/bin/conan install . --output-folder=build --build=missing -s build_type=Debug",
                    "cmake --preset conan-debug -G Ninja"
                ],
                "windows": [
                    "conan install . --output-folder=build --build=missing -s build_type=Debug",
                    "cmake --preset conan-debug"
                ]
            },
            "isBuild": true,
            "name": "CMake (configure/Debug)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": {
                "linux": [
                    "~/.local/bin/conan install . --output-folder=build --build=missing -s build_type=Release",
                    "cmake --preset conan-release -G Ninja"
                ],
                "windows": [
                    "conan install . --output-folder=build --build=missing -s build_type=Release",
                    "cmake --preset conan-release"
                ]
            },
            "isBuild": true,
            "name": "CMake (configure/Release)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-debug",
            "isBuild": true,
            "name": "CMake Build Debug (parallel)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-release",
            "isBuild": true,
            "name": "CMake Build Release (parallel)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-debug --verbose -j 1",
            "isBuild": true,
            "name": "CMake Build Debug (single thread)",
            "runDirectory": "${source_directory}"
        }
    ]
}
