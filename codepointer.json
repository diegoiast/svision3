    "hideFilter": ".git;.vscode;.vs;cbuild;dist;out;build;themes",
    "tasks": [
        {
            "commands": {
                "linux": [
                    "~/.local/bin/conan install . --output-folder=. --build=missing -s build_type=Debug",
                    "cmake --preset conan-debug -G Ninja"
                ],
                "windows": [
                    "conan install . --output-folder=. --build=missing -pr:h conan-debug",
                    "cmake --preset conan-default"
                ]
            },
            "isBuild": true,
            "name": "CMake (configure/Debug)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": {
                "linux": [
                    "~/.local/bin/conan install . --output-folder=. --build=missing -s build_type=Release",
                    "cmake --preset conan-release -G Ninja"
                ],
                "windows": [
                    "conan install . --output-folder=. --build=missing -pr:h default",
                    "cmake --preset conan-default"
                ]
            },
            "isBuild": true,
            "name": "CMake (configure/Release)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-debug",
            "isBuild": true,
            "name": "CMake Build Debug (parallel)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-debug --verbose -j 1",
            "isBuild": true,
            "name": "CMake Build Debug (single thread)",
            "runDirectory": "${source_directory}"
        },
        {
            "commands": "cmake --build --preset conan-release",
            "isBuild": true,
            "name": "CMake Build release (parallel)",
            "runDirectory": "${source_directory}"
        }
    ]
}
