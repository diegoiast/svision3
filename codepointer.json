            },
            "name": "Demo (X11)",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "SVISION_PAINT=opengl SVISION_BACKEND=x11 build/Debug/demo",
                "windows": "build\\Debug\\demo.exe"
            },
            "name": "Demo (opengl)",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "SVISION_PAINT=cairo SVISION_BACKEND=wayland build/Debug/demo",
                "windows": "build\\Debug\\demo.exe"
            },
            "name": "Demo (cairo/wayland)",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "SVISION_PAINT=cairo SVISION_BACKEND=wayland build/Debug/demo_declarative",
                "windows": "build\\Debug\\demo_declarative.exe"
            },
            "name": "Demo declarative (cairo/wayland)",
            "runDirectory": "${source_directory}"
        },
        {
            "executables": {
                "linux": "SVISION_BACKEND=x11 build/Debug/demo_declarative",
