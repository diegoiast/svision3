{
  "version": 4,
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (MSVC + Ninja)",
      "description": "Debug build using MSVC via Ninja (requires VS dev prompt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/build/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (MSVC + Ninja)",
      "description": "Release build using MSVC via Ninja (requires VS dev prompt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/build/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    },
    {
      "name": "windows-profile",
      "displayName": "Windows Profile (MSVC + Ninja, RelWithDebInfo)",
      "description": "Optimised build with full PDB symbols for profiling",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-profile",
      "toolchainFile": "${sourceDir}/build/generators/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "windows-profile",
      "configurePreset": "windows-profile",
      "configuration": "RelWithDebInfo",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "execution": {
        "jobs": 8
      }
    }
  ]
}
